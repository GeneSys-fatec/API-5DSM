# Copie para ".env" e ajuste os valores. NUNCA commite o ".env" real.

POSTGRES_USER=bdgd_dev
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bdgd_dev

# Default aponta para o postgis_dev do proprio compose. Para testar contra a
# AWS, sobrescreva com a connection string da instancia RDS.
BDGD_DB_URL=postgresql://bdgd_dev:changeme@postgis_dev:5432/bdgd_dev

SPRING_DATASOURCE_URL=jdbc:postgresql://postgis_dev:5432/bdgd_dev
SPRING_DATASOURCE_USERNAME=bdgd_dev
SPRING_DATASOURCE_PASSWORD=changeme

N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/get-etl-data

JWT_SECRET=changeme-in-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
