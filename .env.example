# ============================================================================
# .env.example — docker-compose.dev.yml (raiz do repositório)
# ============================================================================
# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.
# NUNCA commite o arquivo ".env" real — ele já está listado no .gitignore.
#
# Para apontar qualquer serviço para o banco AWS em vez do postgis_dev local,
# basta sobrescrever BDGD_DB_URL / SPRING_DATASOURCE_URL* abaixo — nenhum
# código ou docker-compose.dev.yml precisa ser alterado.
# ============================================================================

# --- postgis_dev (banco local do docker-compose.dev.yml) ------------------
POSTGRES_USER=bdgd_dev
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bdgd_dev

# --- etl (ETL/main.py, containerizado, roda sob "--profile etl") ----------
# Default: aponta para o postgis_dev do próprio compose.
BDGD_DB_URL=postgresql://bdgd_dev:changeme@postgis_dev:5432/bdgd_dev

# Para testar contra o banco real na AWS, sobrescreva com a connection string
# da instância RDS (mesmo formato usado em ETL/.env hoje):
# BDGD_DB_URL=postgresql://<usuario>:<senha>@<host-rds>:5432/postgres

# --- backend (Spring Boot, containerizado) ---------------------------------
# Default: aponta para o postgis_dev do próprio compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgis_dev:5432/bdgd_dev
SPRING_DATASOURCE_USERNAME=bdgd_dev
SPRING_DATASOURCE_PASSWORD=changeme

# Para apontar o backend para a AWS em vez do banco local:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host-rds>:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<senha>

# --- integração backend -> n8n (workflow de ETL, fora deste repo) ----------
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/get-etl-data

# --- segurança (JWT do backend) --------------------------------------------
JWT_SECRET=changeme-in-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
